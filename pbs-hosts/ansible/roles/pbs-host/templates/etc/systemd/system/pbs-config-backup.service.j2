# Managed by Ansible (pbs-host role, tasks/config_backup.yml).
# One-shot tar of /etc/proxmox-backup to the NAS, driven by
# pbs-config-backup.timer. Reads /etc/default/pbs-config-backup for the
# source / destination / retention. No PBS API, no credentials.
[Unit]
Description=Back up this PBS host's /etc/proxmox-backup to the NAS
ConditionFileIsExecutable=/usr/local/sbin/pbs-config-backup
# Pull in (and wait for) the NAS mount that backs the destination, so the
# job never runs before the export is available — and never silently
# writes the tarball to the local root filesystem if the NAS is down.
RequiresMountsFor={{ pbs_config_backup_dest_dir }}

[Service]
Type=oneshot
EnvironmentFile=/etc/default/pbs-config-backup
ExecStart=/usr/local/sbin/pbs-config-backup
# The tar of a small config dir is quick, but allow headroom so a slow
# NFS round-trip doesn't trip a start timeout.
TimeoutStartSec=600
