# Managed by Ansible (pbs-host role, tasks/ups.yml).
# One-shot UPS check, driven by nas-ups-guardian.timer. Reads
# /etc/default/nas-ups-guardian for mode + NUT target + thresholds. A
# no-op on line power; only drains PBS + powers off this host when the
# UPS is on battery at/below the configured charge threshold.
[Unit]
Description=NAS UPS guardian - drain PBS and shut down before the NAS loses power
ConditionFileIsExecutable=/usr/local/sbin/nas-ups-guardian

[Service]
Type=oneshot
EnvironmentFile=/etc/default/nas-ups-guardian
ExecStart=/usr/local/sbin/nas-ups-guardian
# The script powers the host off itself once PBS is drained; it must
# never be killed mid-drain by a start-timeout (the drain grace can run
# tens of seconds).
TimeoutStartSec=0
