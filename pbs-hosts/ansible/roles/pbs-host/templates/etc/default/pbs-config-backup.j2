# Managed by Ansible (pbs-host role, tasks/config_backup.yml). Re-rendered
# on each `just pbs-hosts` run. Tunables for /usr/local/sbin/pbs-config-backup.
#
# This job tars PBS_CONFIG_SOURCE to a timestamped .tar.gz under
# PBS_CONFIG_DEST_DIR (on the NAS) and ages out copies older than
# PBS_CONFIG_KEEP_DAYS. No secret lives here — the job never touches the
# PBS API.

# What to back up.
PBS_CONFIG_SOURCE={{ pbs_config_backup_source }}

# Where the tarballs land. Expected to be a directory on the NAS NFS
# mount (a sibling of the datastore, not inside it), so a pbs01 disk
# death doesn't take the backups with it and the NAS replicates them to
# the secondary. The systemd unit's RequiresMountsFor guards against
# writing to local disk if the mount is down.
PBS_CONFIG_DEST_DIR={{ pbs_config_backup_dest_dir }}

# Filename prefix (the host name keeps backups from different hosts
# distinct in a shared destination). Full name: <prefix>-<timestamp>.tar.gz
PBS_CONFIG_PREFIX={{ pbs_config_backup_prefix }}

# Delete tarballs older than this many days (0 disables pruning).
PBS_CONFIG_KEEP_DAYS={{ pbs_config_backup_keep_days }}

# 1 = simulate (log the intended actions, write/delete nothing). For testing.
DRY_RUN={{ pbs_config_backup_dry_run | int }}
