# .env.example — copy to .env.<node> (one per Proxmox host) and fill in.
# DO NOT commit a populated .env.<node>.
#
# Cluster note: VMIDs are cluster-wide unique post-cluster, so each node's
# template needs a DIFFERENT VM_ID. Convention (matches the
# `local.ubuntu_template_ids` map in every Linux role's terraform/main.tf
# and the case statement in scripts/preflight.sh — see ADR-0006):
#
#   pve12t  -> VM_ID=9100
#   pve13m  -> VM_ID=9101
#   pve13t  -> VM_ID=9102
#   pve12t2 -> VM_ID=9103
#
# Fill in .env.pve12t once, then sed-fanout (the token is cluster-replicated
# via /etc/pve/user.cfg, so PROXMOX_URL + PROXMOX_NODE + VM_ID are the only
# differences per host):
#
#   cp .env.example .env.pve12t && $EDITOR .env.pve12t   # fill PROXMOX_TOKEN_*
#   sed -e 's/pve12t/pve13m/g' -e 's/^VM_ID="9100"/VM_ID="9101"/' \
#       .env.pve12t > .env.pve13m
#   sed -e 's/pve12t/pve13t/g' -e 's/^VM_ID="9100"/VM_ID="9102"/' \
#       .env.pve12t > .env.pve13t
#   sed -e 's/pve12t/pve12t2/g' -e 's/^VM_ID="9100"/VM_ID="9103"/' \
#       .env.pve12t > .env.pve12t2
#   chmod 600 .env.pve12t .env.pve13m .env.pve13t .env.pve12t2
#
# Then build:
#   ./build-pve.sh pve12t        # builds VM 9100 on pve12t
#   ./build-pve.sh pve13m        # builds VM 9101 on pve13m
#   ./build-pve.sh pve13t        # builds VM 9102 on pve13t
#   ./build-pve.sh pve12t2       # builds VM 9103 on pve12t2
#
# Required
# ---------
PROXMOX_URL="https://pve12t:8006/api2/json"
PROXMOX_TOKEN_ID="packer@pve!builder"
PROXMOX_TOKEN_SECRET="00000000-0000-0000-0000-000000000000"
PROXMOX_NODE="pve12t"

# Optional — uncomment to override the HCL defaults
# ----------------------------------------------------
PROXMOX_SKIP_TLS_VERIFY="true"
VM_ID="9100"                          # bump per node in a cluster — see header
VM_NAME="ubuntu-24-04-base"
VM_CORES="2"
VM_MEMORY="2048"
VM_DISK_SIZE="20G"
VM_STORAGE_POOL="local-lvm"
#VM_BRIDGE="vmbr0"
#VLAN_TAG=""

# ISO source — pick ONE of these strategies:
#
# Strategy A (default): use an ISO already uploaded to Proxmox
ISO_FILE="local:iso/ubuntu-24.04.1-live-server-amd64.iso"
#
# Strategy B: have Proxmox download the ISO into a storage pool
#ISO_FILE=""
#ISO_URL="https://releases.ubuntu.com/24.04/ubuntu-24.04.1-live-server-amd64.iso"
ISO_CHECKSUM="sha256:e240e4b801f7bb68c20d1356b60968ad0c33a41d00d828e74ceb3364a0317be9"
ISO_STORAGE_POOL="local"

# Build-time SSH credentials. The 'packer' user is created by autoinstall,
# used by Packer to run provisioners, and DELETED before template conversion.
# If you change BUILD_PASSWORD, regenerate the hash in http/user-data:
#   python3 -c "import crypt; print(crypt.crypt('NEWPASS', crypt.mksalt(crypt.METHOD_SHA512)))"
#BUILD_USERNAME="packer"
#BUILD_PASSWORD="packer-build-only"
