# .env.pve.example — copy to .env.<node> for each Proxmox host you build
# against. DO NOT commit a populated file.
#
# Cluster note: VMIDs are cluster-wide unique post-cluster, so each node's
# template needs a DIFFERENT VM_ID. Windows convention (see ADR-0006):
#
#   pve12t -> VM_ID=9200
#   pve13m -> VM_ID=9201
#   pve13t -> VM_ID=9202
#
# Fill in .env.pve12t once, then sed-fanout (the token is cluster-replicated
# via /etc/pve/user.cfg, so PROXMOX_URL + PROXMOX_NODE + VM_ID are the only
# differences per host):
#
#   cp .env.pve.example .env.pve12t && $EDITOR .env.pve12t
#   sed -e 's/pve12t/pve13m/g' -e 's/^VM_ID="9200"/VM_ID="9201"/' \
#       .env.pve12t > .env.pve13m
#   sed -e 's/pve12t/pve13t/g' -e 's/^VM_ID="9200"/VM_ID="9202"/' \
#       .env.pve12t > .env.pve13t
#   chmod 600 .env.pve12t .env.pve13m .env.pve13t
#
# Then build:
#   ./build-pve.sh pve12t        # → VM 9200 on pve12t
#   ./build-pve.sh pve13m        # → VM 9201 on pve13m
#   ./build-pve.sh pve13t        # → VM 9202 on pve13t

# ============================================================================
# Proxmox API connection — required
# ============================================================================
PROXMOX_URL="https://pve12t:8006/api2/json"
PROXMOX_TOKEN_ID="packer@pve!builder"
PROXMOX_TOKEN_SECRET="00000000-0000-0000-0000-000000000000"
PROXMOX_NODE="pve12t"
PROXMOX_SKIP_TLS_VERIFY="true"

# ============================================================================
# ISOs already uploaded to Proxmox storage — required
# ============================================================================
# Get the Win11 ISO from:
#   https://www.microsoft.com/software-download/windows11
# Get virtio-win.iso from:
#   https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso
# Upload both via Proxmox UI or `pvesm upload` before running build-pve.sh.
ISO_FILE="local:iso/Win11_24H2_English_x64.iso"
VIRTIO_ISO_FILE="local:iso/virtio-win-0.1.285.iso"
ISO_STORAGE_POOL="local"

# ============================================================================
# VM hardware sizing — optional (uncomment to override variables.pkr.hcl)
# ============================================================================
VM_ID="9200"                          # bump per node in a cluster — see header
VM_NAME="windows-11-base"
VM_CORES="4"
VM_MEMORY="8192"
VM_DISK_SIZE="60G"
VM_STORAGE_POOL="local-lvm"
#VM_BRIDGE="vmbr0"
#VLAN_TAG=""

# Build-time admin credentials. Autounattend.xml has the password embedded;
# if you change BUILD_PASSWORD, also change it in http/Autounattend.xml.
#BUILD_USERNAME="Administrator"
#BUILD_PASSWORD="packer-build-only-Win11!"
