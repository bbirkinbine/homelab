.DS_Store
.claude/

# Editor / merge / backup detritus — never commit these by accident.
*.bak
*.orig
*.swp
*~

# Local credentials — never commit (defense in depth; subdirs may have their own .gitignore too)
.env
.env.*
!.env.*.example
!.env.example

# OpenTofu / Terraform — local state, provider cache, hydrated tfvars.
# The .tpl (committed template with kp:// placeholders) and the
# .example (committed manual-fill alternative) are explicitly NOT
# ignored; only the resolved .tfvars and the state files are.
vms/*/terraform/.terraform/
vms/*/terraform/terraform.tfstate
vms/*/terraform/terraform.tfstate.backup
vms/*/terraform/terraform.tfvars
vms/*/terraform/*.auto.tfvars
vms/*/terraform/crash.log
vms/*/terraform/crash.*.log

# Ansible — local inventory with real IPs; retry files from failed runs.
vms/*/ansible/inventory.yml
vms/*/ansible/*.retry
vms/*/ansible/.ansible_galaxy

# Same patterns for the layer-0 pve-host role under pve-hosts/.
pve-hosts/ansible/inventory.yml
pve-hosts/ansible/*.retry
pve-hosts/ansible/.ansible_galaxy

# Same patterns for the layer-0 pbs-host role under pbs-hosts/.
pbs-hosts/ansible/inventory.yml
pbs-hosts/ansible/*.retry
pbs-hosts/ansible/.ansible_galaxy

# Same patterns for the layer-0 pdm-host role under pdm-hosts/.
pdm-hosts/ansible/inventory.yml
pdm-hosts/ansible/*.retry
pdm-hosts/ansible/.ansible_galaxy
