---
# pve-hosts/ansible/inventory.yml.example
#
# Copy to inventory.yml (gitignored) and fill in the placeholder values
# marked with `# TODO`. Three nodes in the cluster, each carrying its
# own per-host settings via inline `vars:` blocks. We keep one flat
# inventory file rather than splitting into group_vars/host_vars
# because (a) the per-host divergences are small and (b) it matches the
# convention used by vms/*/ansible/inventory.yml.example.
#
# Why static (not dynamic): every Proxmox node has a DHCP reservation
# on the router so its LAN IP is stable across reboots. Once entered
# here the file is write-once.
#
# Loopback IPs (`tb_loopback`) and TB link subnets are FIXED by the TB
# fabric design in the vault doc [[Thunderbolt Mesh Networking — 3-Node
# Cluster Option]]. Do not change them without updating the decision
# doc first.

pve_hosts:
  vars:
    # ----- cluster-wide -----
    # Replace with your actual LAN subnet/gateway.
    pve_lan_subnet: "192.0.2.0/24"          # RFC 5737 docs range — replace with real LAN subnet
    pve_lan_gateway: "192.0.2.1"            # replace with real LAN gateway

    # TB fabric — frozen per the vault decision doc
    pve_tb_migration_subnet: "10.10.10.0/24"

    # NAS
    nas_hostname: "asustor.lan"             # TODO: confirm or change
    nas_ip: "192.0.2.10"                    # replace with real NAS IP
    nas_nfs_export: "/volume1/proxmox-vms"  # confirm against ADM Shared Folders
    nas_mount_point: "/mnt/nas-vms"

    # Repos — PVE 9.x = Debian 13 (trixie)
    pve_repo_distribution: "trixie"

    # Time sync targets
    chrony_servers:
      - "time.cloudflare.com"
      - "0.pool.ntp.org"
      - "1.pool.ntp.org"

    # SSH key allowed to root@<host>. Single string; multi-line via
    # YAML `|` if you have more than one.
    admin_ssh_pubkey: ""                    # TODO: paste your pubkey

    # Common Ansible connection bits — Packer base ships python3.
    ansible_user: root
    ansible_python_interpreter: /usr/bin/python3

  hosts:
    # NIC naming note: the Proxmox 9.x installer writes a per-host
    # `.link` file at `/usr/local/lib/systemd/network/50-pmx-nic0.link`
    # matching the management NIC by MAC and renaming it to `nic0`.
    # This is PVE 9 behavior, NOT hardware- or firmware-specific —
    # any PVE 9.x install on any platform produces `nic0`. Older PVE
    # versions and other Debian installs show systemd's predictable
    # name (`enpXsY`, or `enoX` if SMBIOS Type 41 exposes an onboard
    # slot designation). Verify with `ip link` post-install; the
    # default below assumes PVE 9.x.
    #
    # TB note: PCI paths for `tb_links` entries are NOT declared here.
    # The role's `thunderbolt.yml` task discovers them from sysfs at run
    # time by matching `device_name` against `tb_links[].peer`, after
    # enrolling each peer via `boltctl enroll --policy=auto`. No operator
    # action between plugging the cables and `just pve-hosts`.

    # ---- pve12t (NUC12 Pro Tall, eGPU host, TB leaf) ----
    pve12t:
      ansible_host: 192.0.2.12              # replace with real LAN IP
      pve_lan_iface: "nic0"                 # PVE 9 default (verify with `ip link`)
      pve_lan_ip: "192.0.2.12"              # replace with real LAN IP
      tb_role: "leaf"
      tb_loopback: "10.10.10.12"
      # Single TB link to pve13m.
      tb_links:
        - name: "tbnet-13m"
          peer: "pve13m"
          local_addr: "10.10.0.0/31"
          peer_addr: "10.10.0.1"
      ip_forwarding_enabled: false
      # Context only — the role does not manage these. They're set up
      # at install time (see docs/proxmox-install.md).
      local_pools_note: |
        - nuc12-fast (LVM-thin, LLM models cache)
        # Root CA encryption moved in-VM 2026-05-11; no host-side LUKS pool.

    # ---- pve13m (NUC13 Pro slim, TB transit node) ----
    pve13m:
      ansible_host: 192.0.2.13              # replace with real LAN IP
      pve_lan_iface: "nic0"                 # PVE 9 default (verify with `ip link`)
      pve_lan_ip: "192.0.2.13"              # replace with real LAN IP
      tb_role: "transit"
      tb_loopback: "10.10.10.13"
      # Two TB links — one to each leaf.
      tb_links:
        - name: "tbnet-12t"
          peer: "pve12t"
          local_addr: "10.10.0.1/31"
          peer_addr: "10.10.0.0"
        - name: "tbnet-13t"
          peer: "pve13t"
          local_addr: "10.10.0.2/31"
          peer_addr: "10.10.0.3"
      # Transit node: IP forwarding required so pve12t↔pve13t traffic
      # can hop through here at L3.
      ip_forwarding_enabled: true

    # ---- pve13t (NUC13 Pro Tall, TB leaf, spare port for future use) ----
    pve13t:
      ansible_host: 192.0.2.14              # replace with real LAN IP
      pve_lan_iface: "nic0"                 # PVE 9 default (verify with `ip link`)
      pve_lan_ip: "192.0.2.14"              # replace with real LAN IP
      tb_role: "leaf"
      tb_loopback: "10.10.10.14"
      # Single TB link to pve13m.
      tb_links:
        - name: "tbnet-13m"
          peer: "pve13m"
          local_addr: "10.10.0.3/31"
          peer_addr: "10.10.0.2"
      ip_forwarding_enabled: false
