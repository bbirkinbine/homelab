# Managed by Ansible (pve-host role, tasks/ups.yml).
# Polls the UPS every {{ pve_host_ups_poll_interval }}; the first poll is
# delayed {{ pve_host_ups_poll_boot_delay }} after boot so qm and the
# cluster settle. Each poll is cheap (two upsc reads) and a no-op unless
# the UPS is on battery and low.
[Unit]
Description=Poll the UPS; trigger a cluster-safe shutdown on low battery

[Timer]
OnBootSec={{ pve_host_ups_poll_boot_delay }}
OnUnitActiveSec={{ pve_host_ups_poll_interval }}
AccuracySec=5s
Unit=nas-ups-guardian.service

[Install]
WantedBy=timers.target
