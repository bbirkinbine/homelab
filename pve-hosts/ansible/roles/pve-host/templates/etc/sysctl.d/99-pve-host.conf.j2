# /etc/sysctl.d/99-pve-host.conf — managed by Ansible (pve-host role).
# Network buffer tuning for high-MTU TB-net flows. TB-net runs at
# MTU 65520; default Debian socket buffers (~200 KiB) bottleneck the
# fabric well below its 20-25 Gbps line rate per the iperf3 tests in
# vault doc [[Thunderbolt Mesh Networking — 3-Node Cluster Option]]
# Phase 6.
#
# These values are CEILINGS, not commitments — the kernel autotunes
# within them. Conservative on purpose; bumping them further has
# diminishing returns and may starve userspace allocations under
# memory pressure.

net.core.rmem_max = 268435456
net.core.wmem_max = 268435456
net.ipv4.tcp_rmem = 4096 87380 268435456
net.ipv4.tcp_wmem = 4096 65536 268435456
