#cloud-config
#
# nemoclaw VM — first-boot identity ONLY.
#
# Rendered by templatefile() in vms/nemoclaw/terraform/main.tf. Cloud-init
# placeholders are Terraform's $${var} interpolation — Terraform
# substitutes everything before upload; cloud-init does not interpret
# anything in this file.
#
# Per the 2026-04-25 provisioning-layer model, cloud-init's job here
# is narrow:
#   1. Set the hostname.
#   2. Create the admin user with sudo + SSH key.
#
# Everything else — Docker apt repo + install, NodeSource apt repo +
# Node 22, npm install nemoclaw, service user + docker group + linger,
# ufw — is Ansible's job. Cloud-init runs ONCE per instance-id;
# Ansible can re-run idempotently, so anything that might need to
# change later belongs there.

hostname: ${hostname}

users:
  - name: ${admin_username}
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - "${ssh_public_key}"
