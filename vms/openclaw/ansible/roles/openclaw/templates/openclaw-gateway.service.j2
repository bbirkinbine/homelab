# Managed by Ansible — vms/openclaw/ansible/roles/openclaw/templates/openclaw-gateway.service.j2
#
# OpenClaw gateway as a system-wide systemd unit. Upstream's
# `openclaw onboard --install-daemon` writes a user-systemd unit
# under the operator's home; this is the system equivalent so the
# gateway runs without an operator login session and survives
# reboots without `loginctl enable-linger`.
#
# Onboarding state (channel pairings, model OAuth tokens) lives under
# {{ openclaw_service_home }}/.openclaw, which is what OPENCLAW_HOME
# pins below. That state is what gets backed up; the gateway binary
# itself is reproducible from the npm package.

[Unit]
Description=OpenClaw gateway (personal AI assistant)
Documentation=https://docs.openclaw.ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openclaw_service_user }}
Group={{ openclaw_service_group }}
WorkingDirectory={{ openclaw_service_home }}
Environment=HOME={{ openclaw_service_home }}
Environment=OPENCLAW_HOME={{ openclaw_service_home }}/.openclaw
# Use the global npm-installed `openclaw` binary. `which openclaw`
# resolves to /usr/bin/openclaw on the NodeSource install — keeping
# the path explicit here avoids surprises if anyone fiddles with the
# service user's PATH later.
ExecStart=/usr/bin/openclaw gateway --port {{ openclaw_gateway_port }} --verbose
Restart=on-failure
RestartSec=5

# Soft hardening — the gateway needs network egress (LLM provider
# APIs + channel WebSockets) and write access to its workspace.
# More aggressive sandboxing (NoNewPrivileges, ProtectSystem=strict)
# is doable but interacts poorly with the gateway's own sandbox
# mechanism (it spawns Docker/bwrap subprocesses). Keep this loose
# until upstream documents what's compatible.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
