# vms/__ROLE__/terraform/terraform.tfvars.example
#
# Copy to terraform.tfvars (gitignored) and fill in real values, OR
# copy to terraform.tfvars.tpl with kp:// placeholders and use
# `just hydrate __ROLE__` to resolve them against KeePassXC.
#
# See docs/opentofu-setup.md for the hydration workflow.

# Proxmox API endpoint URL. The bpg/proxmox provider expects scheme
# + host + port; trailing slash is OK. Any cluster node is fine —
# pmxcfs replicates user.cfg so the token works against all nodes.
proxmox_endpoint = "https://pve12t:8006/"

# Full API token in `user@realm!tokenid=secret-uuid` form.
# See docs/proxmox-tofu-permissions.md for how to mint one. The token's
# role must include the privileges enumerated there.
#
# When you switch to the .tpl + hydrate flow, this line becomes:
#   proxmox_api_token = "kp://Homelab/Tofu/proxmox-api-token"
proxmox_api_token = "tofu@pve!apply=00000000-0000-0000-0000-000000000000"

# Proxmox node name to create the VM on. Default pve12t; switch to
# pve13m / pve13t to land on a different node. Cluster-mobile roles
# can live-migrate after deploy regardless of which node they land on.
proxmox_node = "pve12t"

# First-boot admin user. cloud-init creates this with sudo + the SSH
# key below. Ansible runs against this user for all subsequent config.
admin_username = "__ROLE__-admin"

# Single-line authorized_key. ssh-ed25519 recommended (shorter, faster
# verify, and what KeePassXC stores cleanly on a single line).
ssh_public_key = "ssh-ed25519 AAAA...your-pubkey... brianbirkinbine@workstation"

# Storage overrides — uncomment to deviate from the defaults in
# variables.tf (nas-vms for both, which makes the VM cluster-mobile).
# Flip to local-lvm + per-node `local` only if this role is hardware-
# pinned (USB / eGPU passthrough) or has a hard I/O-latency requirement.
# disk_storage     = "local-lvm"
# snippets_storage = "local"
