---
# Grafana dashboards provider — watches a directory for *.json files and
# loads/refreshes them every `updateIntervalSeconds`. The canonical set
# (Node Exporter Full, Proxmox via Prometheus, natrontech PBS) is
# downloaded + substituted + dropped here by tasks/dashboards.yml.
# Operator UI imports also land in this directory (allowUiUpdates: true).

apiVersion: 1

providers:
  - name: homelab
    orgId: 1
    folder: ''
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: true
    options:
      path: {{ monitoring_grafana_dashboards_dir }}
      foldersFromFilesStructure: true
