---
# Managed by Ansible — vms/monitoring/ansible/roles/monitoring/templates/prometheus.yml.j2
# Edits here will be overwritten on the next `just ansible monitoring`.

global:
  scrape_interval: {{ monitoring_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_prometheus_evaluation_interval }}
  external_labels:
    cluster: homelab

# Recording rules — see prometheus-rules.yml.j2. Currently used to
# materialize `nut_real_power_derived_watts` (load% × nominal capacity)
# since CyberPower BR-series UPSes don't expose ups.realpower directly.
rule_files:
  - /etc/prometheus/rules/homelab.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node_exporter
    static_configs:
{% for t in monitoring_node_exporter_targets %}
      - targets: ['{{ t.host }}:9100']
        labels:
          instance: '{{ t.instance }}'
{% endfor %}

  # prometheus-pve-exporter exposes a per-node target via the `target`
  # query parameter — Prometheus relabels the `__address__` into the
  # exporter's HTTP endpoint and forwards `target=<node>` for the exporter
  # to scrape. Pattern documented in the upstream README's "Multi-target
  # configuration" section.
  - job_name: pve
    metrics_path: /pve
    params:
      module: [default]
      cluster: ['1']
      node: ['1']
    static_configs:
      - targets:
{% for n in monitoring_pve_targets %}
          - '{{ n }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_pve_exporter_port }}

  # natrontech pbs-exporter — single-host. PBS_ENDPOINT in the env
  # file points it at pbs01, so /metrics with no query params is the
  # right shape. The relabel-multi-target pattern (used for pve_exporter
  # above) doesn't apply here because pbs-exporter's `target=` syntax
  # is `target=http://host:port`, not bare hostname, and is ignored
  # when PBS_ENDPOINT is set. If we ever add pbs02, configure a second
  # exporter instance with a different port.
  #
  # Job name MUST be `pbs-exporter` (with hyphen) — natrontech's
  # bundled Grafana dashboard hardcodes `job="pbs-exporter"` in every
  # panel's PromQL, and naming the job differently silently misses
  # every selector. Aligns with their upstream convention.
  - job_name: pbs-exporter
    static_configs:
      - targets:
          - '127.0.0.1:{{ monitoring_pbs_exporter_port }}'
        labels:
          instance: '{{ monitoring_pbs_target }}'

{% if monitoring_dcgm_target %}
  # NVIDIA DCGM Exporter on the llm VM. The container is operator-deployed
  # (see vms/llm/README.md "Expose GPU metrics to Prometheus") — set
  # monitoring_dcgm_target to "" in defaults to skip this scrape job until
  # the container is up, otherwise Prometheus will mark the target as DOWN.
  - job_name: dcgm-exporter
    static_configs:
      - targets: ['{{ monitoring_dcgm_target }}']
        labels:
          instance: llm
{% endif %}

{% if monitoring_nut_target %}
  # HON95's prometheus-nut-exporter is a multi-target exporter: it runs on
  # this VM at 127.0.0.1:{{ monitoring_nut_exporter_port }} and accepts a
  # ?target=<host:port> query parameter pointing at the NUT server. We use
  # the same relabel pattern as the pve job above — Prometheus rewrites
  # __address__ from the configured target into the exporter's local
  # endpoint, forwarding the original as `?target=`. The exporter then
  # opens an upsd TCP connection to that target and returns nut_* metrics
  # for every UPS defined on that server.
  - job_name: nut-exporter
    metrics_path: /nut
    static_configs:
      - targets:
          - '{{ monitoring_nut_target }}'
        labels:
          instance: '{{ monitoring_nut_instance_label }}'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_nut_exporter_port }}
{% endif %}

# Alert rules and Alertmanager wiring land in a follow-up (§5 step 8 of
# the design doc) — out of scope for the MVP.
