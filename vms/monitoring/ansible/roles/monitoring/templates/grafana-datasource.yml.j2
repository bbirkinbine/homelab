---
# Managed by Ansible — auto-provisioned at grafana-server startup.
# Grafana docs: docs.grafana.org → Administration → Provisioning →
# Data sources.

apiVersion: 1

datasources:
  - name: {{ monitoring_grafana_datasource_name }}
    # Pin the UID to a stable lowercase value. Several community dashboards
    # (notably natrontech/pbs-exporter) hardcode `"uid": "prometheus"` in
    # their queries rather than using ${DS_PROMETHEUS}, so panels show "No
    # data" against a Grafana-assigned random UID. Pinning here lets those
    # dashboards work without per-dashboard rewriting.
    uid: {{ monitoring_grafana_datasource_uid }}
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    editable: false
    jsonData:
      timeInterval: {{ monitoring_prometheus_scrape_interval }}
