# /etc/prometheus/pbs-exporter.env — env-file for prometheus-pbs-exporter.
#
# PLACEHOLDER values below. Operator pastes the real values after
# Ansible finishes, then:
#
#     sudo systemctl start prometheus-pbs-exporter
#
# Env-var names from github.com/natrontech/pbs-exporter README.

PBS_ENDPOINT={{ monitoring_pbs_exporter_endpoint }}
PBS_USERNAME=prometheus@pbs
PBS_API_TOKEN_NAME=exporter
PBS_API_TOKEN=REPLACE_ME_WITH_TOKEN_SECRET_FROM_KEEPASSXC
PBS_VERIFY_SSL={{ monitoring_pbs_exporter_verify_ssl | string | lower }}
PBS_LISTEN_ADDRESS=:{{ monitoring_pbs_exporter_port }}
