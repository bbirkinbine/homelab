# vms/openbao/.env.example
#
# Copy to vms/openbao/.env and fill in. The .env file is gitignored
# (matched by /.env* in the repo's top-level .gitignore).
#
# Purpose: stand up the operational OpenBao VM on NUC12 with USB
# passthrough of the labeled HSM-A jack (CardLogix SmartCard-HSM 4K).
# This is the VM that runs Phase 4-onward of the
# "Vault Auto-Unseal with CardLogix Pair" procedure.

# ---- Proxmox connection (deploy.sh runs from your Mac, ssh's to the node) ----
PROXMOX_HOST="pve12t"             # SSH hostname or IP for the Proxmox node
PROXMOX_NODE="pve12t"             # Cluster node name (qm operates on this)
SSH_USER="root"                   # SSH user; must be able to run `qm`, `pvesh`, `lsusb`

# ---- Source template ----
# 9100 is the Packer-built ubuntu-24-04-base. We deliberately use the hardened
# template (not a hand-rolled cloud-image VM) because OpenBao is a trust-anchor
# service: provenance and reproducibility matter here.
TEMPLATE_VM_ID="9100"

# ---- New VM identity ----
VM_ID="130"                       # Unique on the Proxmox node
VM_NAME="openbao"                 # Used as Proxmox VM name AND cloud-init hostname

# ---- Sizing ----
# OpenBao with PKCS#11 seal is a light service: a couple of goroutines, a
# small KV store, audit logs. 2 cores / 2 GiB is comfortable; bump later
# if you add more secret engines (transit, PKI, etc.).
VM_CORES="2"
VM_MEMORY="2048"                  # MB
# 32 GiB leaves room for /var/log growth and audit-log retention without
# panicking. The OpenBao data dir itself is tiny (KB-scale).
VM_DISK_SIZE="32G"
# Ballooning is fine for OpenBao (no PCIe passthrough; USB passthrough
# does not pin RAM the way vfio-pci does). 0 disables ballooning;
# leave at 0 unless you want elastic memory.
VM_BALLOON="0"

# ---- Storage / cloud-init delivery ----
VM_STORAGE_POOL="local-lvm"       # Where the cloned disk lives
SNIPPETS_STORAGE="local"          # Storage with 'snippets' content type enabled.
                                  # Datacenter -> Storage -> <name> -> Edit -> Content (check Snippets)

# ---- Machine type ----
# q35 is the modern default. USB passthrough works on i440fx too, but q35
# matches the rest of the homelab and avoids surprises if you later add
# PCIe devices (e.g. a TPM passthrough).
VM_MACHINE="q35"

# ---- HSM USB passthrough (the whole point of this VM) ----
# PREREQUISITE: token A is plugged into the labeled HSM-A jack on the
# Proxmox host. To find the bus-port for that physical jack:
#
#   ssh root@<proxmox-host> 'lsusb -t'
#   # find the line for the CardContact / SCM smartcard reader; the
#   # path looks like: |__ Port 2: Dev 4, If 0, Class=..., Driver=usbfs, ...
#   # Combined with its bus, that yields a host=<bus>-<port> spec.
#
#   ssh root@<proxmox-host> 'dmesg | grep -i "smartcard\|cardcontact\|scm" | tail'
#   # confirms which usb<bus>-<port> the device enumerated on
#
# The HSM_USB_HOST_PORT format for `qm set --usb0 host=...` is "<bus>-<port>"
# (no leading zeros), e.g. "1-2" or "3-1.4" for a port behind an internal
# hub. PIN BY PORT, NOT BY VENDOR:PRODUCT — the labeled physical jack is
# the contract; whichever token sits in it is the token the VM gets.
HSM_USB_HOST_PORT="1-2"

# Force xHCI (USB 3) controller for the passthrough slot. Set to "1" if
# `lsusb -t` on the Proxmox host shows the HSM_USB_HOST_PORT bus running
# at 5000M (USB 3); leave at "0" for 480M (USB 2). The default Proxmox
# USB controller is EHCI (USB 2.0), and attaching a USB 3 device through
# it can silently fail to enumerate inside the guest. CCID smart-card
# readers are slow devices, so the easy fix is "plug into a USB 2 jack
# on the host"; this toggle is for cases where the only available
# physical port is USB 3.
HSM_USB_USB3="0"

# Optional: set HSM_SKIP_USB_CHECK=1 to bypass deploy.sh's sanity check
# that the device at HSM_USB_HOST_PORT looks like a CCID smart-card
# reader. Useful if you're testing with a non-CardLogix CCID device or
# if your lsusb output doesn't match the heuristic. Leave unset in
# normal operation.
# HSM_SKIP_USB_CHECK=""

# ---- First-boot user (cloud-init injects key, sudo, no password) ----
ADMIN_USERNAME="bao-admin"
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... your-key-here"

# ---- sc-hsm-embedded build (optional but recommended) ----
# CardContact's sc-hsm-embedded PKCS#11 module exposes more device-
# specific features than OpenSC's generic opensc-pkcs11.so. The
# auto-unseal procedure uses /usr/local/lib/libsc-hsm-pkcs11.so when
# present and falls back to opensc-pkcs11.so otherwise.
#
# Set BUILD_SC_HSM_EMBEDDED=1 (default) to build it during cloud-init.
# Set BUILD_SC_HSM_EMBEDDED=0 to skip — use this if you'd rather build
# it by hand later for ceremony hygiene, or if first-boot network
# access to github.com is blocked.
BUILD_SC_HSM_EMBEDDED="1"
