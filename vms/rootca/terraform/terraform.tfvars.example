# vms/rootca/terraform/terraform.tfvars.example
#
# Copy to terraform.tfvars (gitignored) and fill in real values, OR
# copy to terraform.tfvars.tpl with kp:// placeholders and use
# `just hydrate rootca` to resolve them against KeePassXC.

# Proxmox API endpoint URL.
proxmox_endpoint = "https://pve12t:8006/"

# Same `tofu@pve!apply` token as openbao — see docs/proxmox-tofu-permissions.md.
proxmox_api_token = "tofu@pve!apply=00000000-0000-0000-0000-000000000000"

# pve12t hosts HSM-A on the labeled jack at bus-port 1-2.
proxmox_node = "pve12t"

# Bootstrap admin (only reachable while enable_network=true).
admin_username = "rootca-admin"
ssh_public_key = "ssh-ed25519 AAAA...your-pubkey... brianbirkinbine@workstation"

# AIR-GAP TOGGLE.
#   true  — bootstrap mode: NIC attached, SSH reachable for `just ansible rootca`.
#   false — operational mode: NIC removed, noVNC console only.
# After bootstrap completes and you've verified the HSM tooling works,
# flip this to false and `tofu apply` again to enforce the air gap.
enable_network = true

# Storage overrides — uncomment to deviate from the defaults in
# variables.tf. rootca defaults to local-lvm + per-node `local` snippets
# because the VM is hardware-pinned to pve12t (HSM USB passthrough) and
# never live-migrates. Encryption is handled INSIDE the guest (LUKS
# partition on the back half of disk_storage, carved by the Ansible
# role), so the underlying Proxmox pool can be plain local-lvm.
# (Pre-2026-05-11 this role used a host-side LUKS Directory pool named
# `rootca-encrypted` via a now-removed `encrypted_storage_pool` variable;
# the host-side approach was dropped in favor of in-VM encryption for
# stronger isolation. See vms/rootca/README.md § "How the air-gap is
# enforced".)
# Flip both to "nas-vms" only if pve12t runs out of local space —
# functionally fine, but adds an NFS dependency to a deliberately
# self-contained offline-CA VM.
# disk_storage     = "local-lvm"
# snippets_storage = "local"

# Physical bus-port of the labeled HSM-A jack on pve12t. Discovered
# 2026-05-10 during legacy openbao deploy.sh testing. If you've
# physically moved the HSM since, re-run `ssh root@pve12t 'lsusb -t'`
# and update this value.
hsm_usb_host_port = "1-2"

# Leave false unless the jack is on USB 3 and EHCI passthrough fails.
hsm_usb3 = false
