---
# vms/rootca/ansible/inventory.yml.example
#
# This file documents the inventory shape. The actual inventory.yml is
# gitignored and is populated automatically by:
#
#   just inventory rootca
#
# That recipe runs scripts/write-inventory.sh, which reads
# `tofu output ansible_inventory_hint` and writes the result here as
# vms/rootca/ansible/inventory.yml. It refuses to write if the
# qemu-guest-agent hasn't reported the VM's IP yet — wait ~30s after
# `just apply rootca` and retry.
#
# Only usable while enable_network=true in terraform.tfvars; after the
# operator flips it to false (Phase B) and tofu removes the NIC,
# Ansible can no longer reach the VM and the inventory becomes a
# museum piece.

rootca_servers:
  hosts:
    rootca:
      ansible_host: 10.0.0.X
      ansible_user: rootca-admin
      ansible_python_interpreter: /usr/bin/python3
